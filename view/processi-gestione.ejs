<!DOCTYPE html>
<html>
<head>
    <title>Web APP DC - Processi</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%- include('partials/head'); %>
    <script type="text/javascript" src="/utility-script"></script>
    <script type="text/javascript" src="/processi-script"></script>
    <script type="text/javascript" src="/control-culture-textbox-script"></script>
    <script type="text/javascript" src="/control-processi-script"></script>
    <script type="text/javascript" src="/processi-gestione-script"></script>
    <script type="text/javascript" src="/logout-script"></script>
</head>
<body>
    <input type="hidden" name="LanguageContext" id="LanguageContext" value="<%= user.LanguageContext %>" />
    <%- include('partials/header'); %>
    <div class="container-fluid p-0 px-4">
        <h4 class="p-0">
            <span class="bi bi-diagram-3" style="font-size:2rem;"></span>&nbsp;
            <span class="f-roboto b">
                <% if (user.LanguageContext == "IT") { %>Processi<% } %>
                <% if (user.LanguageContext == "GB") { %>Processes<% } %>
                <% if (user.LanguageContext == "ES") { %>Procesos<% } %>
                <% if (user.LanguageContext == "CN") { %>流程<% } %>
            </span>
        </h4>

        <div class="col-12 col-xl-6 p-0">
            <div class="card">
                <div class="card-header p-3 f-roboto">
                    <b>
                        <% if (user.LanguageContext == "IT") { %>Processi<% } %>
                        <% if (user.LanguageContext == "GB") { %>Processes<% } %>
                        <% if (user.LanguageContext == "ES") { %>Procesos<% } %>
                        <% if (user.LanguageContext == "CN") { %>流程<% } %>
                    </b>
                </div>
                <div class="card-body p-2 f-roboto">
                    <div id="processi-container" style="overflow-y:auto; max-height:75vh;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="processi-custom-actions-modal" tabindex="-1" aria-labelledby="processi-custom-actions-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title f-roboto b" id="processi-custom-actions-title">
                            <% if (user.LanguageContext == "IT") { %>Azioni custom<% } %>
                            <% if (user.LanguageContext == "GB") { %>Custom actions<% } %>
                            <% if (user.LanguageContext == "ES") { %>Acciones personalizadas<% } %>
                            <% if (user.LanguageContext == "CN") { %>自定义操作<% } %>
                        </h5>
                        <span class="text-secondary processi-custom-actions-process-name"></span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center processi-custom-actions-loading" style="display:none;">
                        <span class="spinner-border text-info" role="status"></span>
                    </div>
                    <div class="processi-custom-actions-list"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <% if (user.LanguageContext == "IT") { %>Chiudi<% } %>
                        <% if (user.LanguageContext == "GB") { %>Close<% } %>
                        <% if (user.LanguageContext == "ES") { %>Cerrar<% } %>
                        <% if (user.LanguageContext == "CN") { %>关闭<% } %>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div id="processi-action-culture-control"></div>
    <div class="modal fade" id="processi-delete-modal" tabindex="-1" aria-labelledby="processi-delete-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title f-roboto b" id="processi-delete-title">
                        <% if (user.LanguageContext == "IT") { %>Conferma eliminazione<% } %>
                        <% if (user.LanguageContext == "GB") { %>Confirm deletion<% } %>
                        <% if (user.LanguageContext == "ES") { %>Confirmar eliminación<% } %>
                        <% if (user.LanguageContext == "CN") { %>确认删除<% } %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="processi-delete-confirm-message">
                        <% if (user.LanguageContext == "IT") { %>Confermi di voler eliminare questo processo? L'operazione non può essere annullata.<% } %>
                        <% if (user.LanguageContext == "GB") { %>Are you sure you want to delete this process? This action cannot be undone.<% } %>
                        <% if (user.LanguageContext == "ES") { %>¿Confirma que desea eliminar este proceso? Esta acción no se puede deshacer.<% } %>
                        <% if (user.LanguageContext == "CN") { %>确定要删除此流程吗？此操作无法撤销。<% } %>
                    </p>
                    <strong class="processi-delete-process-description"></strong>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <% if (user.LanguageContext == "IT") { %>Annulla<% } %>
                        <% if (user.LanguageContext == "GB") { %>Cancel<% } %>
                        <% if (user.LanguageContext == "ES") { %>Cancelar<% } %>
                        <% if (user.LanguageContext == "CN") { %>取消<% } %>
                    </button>
                    <button type="button" class="btn btn-danger processi-delete-confirm">
                        <% if (user.LanguageContext == "IT") { %>Elimina<% } %>
                        <% if (user.LanguageContext == "GB") { %>Delete<% } %>
                        <% if (user.LanguageContext == "ES") { %>Eliminar<% } %>
                        <% if (user.LanguageContext == "CN") { %>删除<% } %>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="processi-edit-modal" tabindex="-1" aria-labelledby="processi-edit-title" aria-hidden="true" data-bs-focus="false">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title f-roboto b" id="processi-edit-title">
                        <span class="processi-edit-title-label">
                            <% if (user.LanguageContext == "IT") { %>Modifica processo<% } %>
                            <% if (user.LanguageContext == "GB") { %>Edit process<% } %>
                            <% if (user.LanguageContext == "ES") { %>Editar proceso<% } %>
                            <% if (user.LanguageContext == "CN") { %>编辑流程<% } %>
                        </span>
                        <span class="text-secondary processi-edit-description-title"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height:70vh; overflow-y:auto;">
                    <div class="text-center processi-edit-loading" style="display:none;">
                        <span class="spinner-border text-info" role="status"></span>
                    </div>
                    <div class="row g-3 processi-edit-fields">
                        <div class="col-md-4">
                            <label for="processi-edit-parent" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>ID processo padre<% } %>
                                <% if (user.LanguageContext == "GB") { %>Parent process ID<% } %>
                                <% if (user.LanguageContext == "ES") { %>ID del proceso padre<% } %>
                                <% if (user.LanguageContext == "CN") { %>父流程 ID<% } %>
                            </label>
                            <select class="form-select" id="processi-edit-parent">
                                <option value="">
                                    <% if (user.LanguageContext == "IT") { %>Nessun processo padre<% } %>
                                    <% if (user.LanguageContext == "GB") { %>No parent process<% } %>
                                    <% if (user.LanguageContext == "ES") { %>Sin proceso padre<% } %>
                                    <% if (user.LanguageContext == "CN") { %>无父流程<% } %>
                                </option>
                            </select>
                        </div>
                        <div class="col-md-8 processi-edit-description-control">
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-page-url" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>URL pagina<% } %>
                                <% if (user.LanguageContext == "GB") { %>Page URL<% } %>
                                <% if (user.LanguageContext == "ES") { %>URL de la página<% } %>
                                <% if (user.LanguageContext == "CN") { %>页面 URL<% } %>
                            </label>
                            <input type="text" maxlength="50" class="form-control" id="processi-edit-page-url">
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-page-url-vendor" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>URL pagina fornitore<% } %>
                                <% if (user.LanguageContext == "GB") { %>Vendor page URL<% } %>
                                <% if (user.LanguageContext == "ES") { %>URL de la página del proveedor<% } %>
                                <% if (user.LanguageContext == "CN") { %>供应商页面 URL<% } %>
                            </label>
                            <input type="text" maxlength="50" class="form-control" id="processi-edit-page-url-vendor">
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-parameters" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>Parametri<% } %>
                                <% if (user.LanguageContext == "GB") { %>Parameters<% } %>
                                <% if (user.LanguageContext == "ES") { %>Parámetros<% } %>
                                <% if (user.LanguageContext == "CN") { %>参数<% } %>
                            </label>
                            <textarea maxlength="255" class="form-control" rows="2" id="processi-edit-parameters"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-image-url" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>URL immagine<% } %>
                                <% if (user.LanguageContext == "GB") { %>Image URL<% } %>
                                <% if (user.LanguageContext == "ES") { %>URL de imagen<% } %>
                                <% if (user.LanguageContext == "CN") { %>图片 URL<% } %>
                            </label>
                            <textarea class="form-control" rows="2" id="processi-edit-image-url"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label for="processi-edit-order" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>Ordine<% } %>
                                <% if (user.LanguageContext == "GB") { %>Order<% } %>
                                <% if (user.LanguageContext == "ES") { %>Orden<% } %>
                                <% if (user.LanguageContext == "CN") { %>顺序<% } %>
                            </label>
                            <input type="number" step="1" class="form-control" id="processi-edit-order">
                        </div>
                        <div class="col-12">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">
                                        <% if (user.LanguageContext == "IT") { %>Pubblico<% } %>
                                        <% if (user.LanguageContext == "GB") { %>Public<% } %>
                                        <% if (user.LanguageContext == "ES") { %>Público<% } %>
                                        <% if (user.LanguageContext == "CN") { %>公开<% } %>
                                    </label>
                                    <div class="form-check form-switch"><input class="form-check-input processi-edit-bit" type="checkbox" id="processi-edit-IsPublic" data-field="IsPublic"></div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">
                                        <% if (user.LanguageContext == "IT") { %>Voce di menu<% } %>
                                        <% if (user.LanguageContext == "GB") { %>Menu item<% } %>
                                        <% if (user.LanguageContext == "ES") { %>Elemento de menú<% } %>
                                        <% if (user.LanguageContext == "CN") { %>菜单项<% } %>
                                    </label>
                                    <div class="form-check form-switch"><input class="form-check-input processi-edit-bit" type="checkbox" id="processi-edit-IsMenu" data-field="IsMenu"></div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">
                                        <% if (user.LanguageContext == "IT") { %>Configurazione di sistema<% } %>
                                        <% if (user.LanguageContext == "GB") { %>System configuration<% } %>
                                        <% if (user.LanguageContext == "ES") { %>Configuración del sistema<% } %>
                                        <% if (user.LanguageContext == "CN") { %>系统配置<% } %>
                                    </label>
                                    <div class="form-check form-switch"><input class="form-check-input processi-edit-bit" type="checkbox" id="processi-edit-IsSystemConfiguration" data-field="IsSystemConfiguration"></div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">
                                        <% if (user.LanguageContext == "IT") { %>Canale<% } %>
                                        <% if (user.LanguageContext == "GB") { %>Channel<% } %>
                                        <% if (user.LanguageContext == "ES") { %>Canal<% } %>
                                        <% if (user.LanguageContext == "CN") { %>渠道<% } %>
                                    </label>
                                    <div class="form-check form-switch"><input class="form-check-input processi-edit-bit" type="checkbox" id="processi-edit-IsChannel" data-field="IsChannel"></div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">
                                        <% if (user.LanguageContext == "IT") { %>Fornitore<% } %>
                                        <% if (user.LanguageContext == "GB") { %>Vendor<% } %>
                                        <% if (user.LanguageContext == "ES") { %>Proveedor<% } %>
                                        <% if (user.LanguageContext == "CN") { %>供应商<% } %>
                                    </label>
                                    <div class="form-check form-switch"><input class="form-check-input processi-edit-bit" type="checkbox" id="processi-edit-IsVendor" data-field="IsVendor"></div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">
                                        <% if (user.LanguageContext == "IT") { %>Processo<% } %>
                                        <% if (user.LanguageContext == "GB") { %>Process<% } %>
                                        <% if (user.LanguageContext == "ES") { %>Proceso<% } %>
                                        <% if (user.LanguageContext == "CN") { %>流程<% } %>
                                    </label>
                                    <div class="form-check form-switch"><input class="form-check-input processi-edit-bit" type="checkbox" id="processi-edit-IsProcess" data-field="IsProcess"></div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">
                                        <% if (user.LanguageContext == "IT") { %>Ha workflow<% } %>
                                        <% if (user.LanguageContext == "GB") { %>Has workflow<% } %>
                                        <% if (user.LanguageContext == "ES") { %>Tiene workflow<% } %>
                                        <% if (user.LanguageContext == "CN") { %>启用工作流<% } %>
                                    </label>
                                    <div class="form-check form-switch"><input class="form-check-input processi-edit-bit" type="checkbox" id="processi-edit-HasWorkflow" data-field="HasWorkflow"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-linked-object" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>Oggetto collegato<% } %>
                                <% if (user.LanguageContext == "GB") { %>Linked object<% } %>
                                <% if (user.LanguageContext == "ES") { %>Objeto vinculado<% } %>
                                <% if (user.LanguageContext == "CN") { %>关联对象<% } %>
                            </label>
                            <input type="text" class="form-control" id="processi-edit-linked-object">
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-object-name" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>Nome oggetto<% } %>
                                <% if (user.LanguageContext == "GB") { %>Object name<% } %>
                                <% if (user.LanguageContext == "ES") { %>Nombre del objeto<% } %>
                                <% if (user.LanguageContext == "CN") { %>对象名称<% } %>
                            </label>
                            <input type="text" class="form-control" id="processi-edit-object-name">
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-object-pk" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>Chiave primaria oggetto<% } %>
                                <% if (user.LanguageContext == "GB") { %>Object primary key<% } %>
                                <% if (user.LanguageContext == "ES") { %>Clave primaria del objeto<% } %>
                                <% if (user.LanguageContext == "CN") { %>对象主键<% } %>
                            </label>
                            <input type="text" class="form-control" id="processi-edit-object-pk">
                        </div>
                        <div class="col-md-6">
                            <label for="processi-edit-object-fk" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>Chiave esterna oggetto<% } %>
                                <% if (user.LanguageContext == "GB") { %>Object foreign key<% } %>
                                <% if (user.LanguageContext == "ES") { %>Clave externa del objeto<% } %>
                                <% if (user.LanguageContext == "CN") { %>对象外键<% } %>
                            </label>
                            <input type="text" class="form-control" id="processi-edit-object-fk">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <% if (user.LanguageContext == "IT") { %>Annulla<% } %>
                        <% if (user.LanguageContext == "GB") { %>Cancel<% } %>
                        <% if (user.LanguageContext == "ES") { %>Cancelar<% } %>
                        <% if (user.LanguageContext == "CN") { %>取消<% } %>
                    </button>
                    <button type="button" class="btn btn-primary processi-edit-save">
                        <% if (user.LanguageContext == "IT") { %>Salva<% } %>
                        <% if (user.LanguageContext == "GB") { %>Save<% } %>
                        <% if (user.LanguageContext == "ES") { %>Guardar<% } %>
                        <% if (user.LanguageContext == "CN") { %>保存<% } %>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <%- include('partials/system-message'); %>
</body>
</html>
