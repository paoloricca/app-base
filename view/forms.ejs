<!DOCTYPE html>
<html>
<head>
    <title>Web APP DC - 
		<% if (user.LanguageContext == "IT") { %>
            Forms
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            Forms
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            Forms
		<% } %>
        <% if (user.LanguageContext == "CN") { %>
            Forms
        <% } %>
    </title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%- include('partials/head'); %>
    <%- include('partials/confirm-delete'); %>
    <script type="text/javascript" src="/processi-script"></script>
    <script type="text/javascript" src="/control-culture-textbox-script"></script>
    <script type="text/javascript" src="/control-confirm-delete-script"></script>
    <script type="text/javascript" src="/model-script"></script>
    <script type="text/javascript" src="/control-fileupload-script"></script>    
    <script type="text/javascript" src="/control-processi-filter-script"></script>
    <script type="text/javascript" src="/control-workflow-script"></script>
    <script type="text/javascript" src="/control-workflow-history-script"></script>
    <script type="text/javascript" src="/control-model-script"></script>
    <script type="text/javascript" src="/control-pager-script"></script>
    <script type="text/javascript" src="/control-processi-action-button-script"></script>
    <script type="text/javascript" src="/utility-script"></script>    
    <script type="text/javascript" src="/forms-script"></script>
    <script type="text/javascript" src="/logout-script"></script>
    <style>
        .modal {
            overflow: auto !important;
        }
    </style>

</head>
<body>
    <%- include('partials/header'); %>
    <input type="hidden" name="LanguageContext" id="LanguageContext" value="<%= user.LanguageContext %>" />
    <input type="hidden" name="user" id="user" value="<%= JSON.stringify(user) %>" />
    <input type="hidden" name="checkConn" id="checkConn" value="<%= checkConn %>" />
    <div class="container-fluid p-0 px-4">
        <h4 class="p-0">
            <span class="bi bi-stack" style="font-size:2rem;"></span>&nbsp;
            <b class="f-roboto b">
		        <% if (user.LanguageContext == "IT") { %>
                    Forms
                <% } %>
                <% if (user.LanguageContext == "GB") { %>
                    Forms
                <% } %>
                <% if (user.LanguageContext == "ES") { %>
                    Forms
		        <% } %>
                <% if (user.LanguageContext == "CN") { %>
                    Forms
                <% } %>
            </b>
        </h4>
    </div>
    <div class="container-fluid h-75" style="display:block; position:absolute; height:80% !important; margin-top:0 !important;">
        <div class="col-lg-3 col-md-3 col-sm-3 mb-2 p-0 h-100 filtro-container">
            <div class="panel panel-default h-100 p-0">
                <div class="panel-heading p-2 f-roboto">
                    <button type="button" class="btn btn-light bi bi-arrow-left rounded-circle float-end btn-30 btn-filter-close"
                        data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<% if (user.LanguageContext == "IT") { %>Nascondi Filtro<% } %><% if (user.LanguageContext == "GB") { %>Hide Filter<% } %><% if (user.LanguageContext == "ES") { %>Ocultar filtro<% } %><% if (user.LanguageContext == "CN") { %>隱藏過濾器<% } %>">
                    </button>
                    <ul class="nav nav-tabs" id="stepTab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="2step-tab" data-bs-toggle="tab" data-bs-target="#2step">
						        <% if (user.LanguageContext == "IT") { %>
                                    Filtro di ricerca
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Search filter
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Filtro de investigaci&oacute;n
						        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    搜尋過濾器
                                <% } %>
                            </button>
                        </li>
                        <li>
                    </ul>
                </div>
                <div class="panel-body p-2">

                    <div class="tab-content mt-3" id="stepTabContent">
                        <div class="tab-pane active" id="2step">
                            <div id="filtro-forms-container" style="overflow-y:auto; height:90%;">
                            </div>
                            <div class="p-3 pt-4">
						        <button type="button" class="btn btn-md btn-secondary text-white w-100 btn-filter-apply">
                                    <% if (user.LanguageContext == "IT") { %>
                                        Cerca
                                    <% } %>
                                    <% if (user.LanguageContext == "GB") { %>
                                        Search
                                    <% } %>
                                    <% if (user.LanguageContext == "ES") { %>
                                        Buscar
			                        <% } %>
                                    <% if (user.LanguageContext == "CN") { %>
                                        靠近
                                    <% } %>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-lg-9 col-md-9 col-sm-9 p-0 h-100 result-container">
            <div class="panel panel-default h-100 p-0">
                <div class="panel-heading p-3 f-roboto">
                    <b>
		                <% if (user.LanguageContext == "IT") { %>
                            Forms
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Forms
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Forms
		                <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            Forms
                        <% } %>
                    </b>
                    <button type="button" class="btn btn-light bi bi-sliders rounded-circle float-end btn-30 btn-filter-open"
                        data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<% if (user.LanguageContext == "IT") { %>Visualizza Filtro<% } %><% if (user.LanguageContext == "GB") { %>View Filter<% } %><% if (user.LanguageContext == "ES") { %>Ver filtro<% } %><% if (user.LanguageContext == "CN") { %>查看過濾器<% } %>">
                    </button>
                    <span class="action-button-inserimento"></span>&nbsp;
                </div>
                <div class="panel-body h-100 p-2 f-roboto">
                    <div class="h-75" style="overflow-y:auto;">
                        <table class="table table-hover table-xs">
                            <thead>
                                <tr>
                                    <th scope="col">
                                    </th>
                                    <th scope="col" class="process-label-id">
					                    <% if (user.LanguageContext == "IT") { %>
                                            ID
                                        <% } %>
                                        <% if (user.LanguageContext == "GB") { %>
                                            ID
                                        <% } %>
                                        <% if (user.LanguageContext == "ES") { %>
                                            ID
					                    <% } %>
                                        <% if (user.LanguageContext == "CN") { %>
                                            ID
                                        <% } %>
                                    </th>
                                    <th scope="col">
					                    <% if (user.LanguageContext == "IT") { %>
                                            Descrizione
                                        <% } %>
                                        <% if (user.LanguageContext == "GB") { %>
                                            Description
                                        <% } %>
                                        <% if (user.LanguageContext == "ES") { %>
                                            Descripci&oacute;n
					                    <% } %>
                                        <% if (user.LanguageContext == "CN") { %>
                                            描述
                                        <% } %>
                                    </th>
                                    <th scope="col" class="hidden-xs">
					                    <% if (user.LanguageContext == "IT") { %>
                                            Data Registrazione
                                        <% } %>
                                        <% if (user.LanguageContext == "GB") { %>
                                            Requested date
                                        <% } %>
                                        <% if (user.LanguageContext == "ES") { %>
                                            Fecha de registro
					                    <% } %>
                                        <% if (user.LanguageContext == "CN") { %>
                                            註冊日期
                                        <% } %>
                                    </th>
                                    <th scope="col">
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="result-forms-container">
                            </tbody>
                        </table>
                    </div>
                    <div class="h-25 align-bottom">
                        <div class="forms-pager pager align-bottom p-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" id="container-processo" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title f-roboto b">
                        <span class="ordine-idrecord-color px-1"></span> <span class="ordine-mode"></span><span class="ordine-reference">&nbsp;{ID                     
                        <% if (user.LanguageContext == "IT") { %>
                        Richiesta
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Request
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        Pedido
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        要求
                        <% } %>: <span class="ordine-idrecord"></span>}</span>
                    </h5>
                    <button type="button" class="btn-close btn-cancel-processo" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div data-user="<%= JSON.stringify(user) %>" class="model">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" id="container-model-versions" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-keyboard="false">
        <div class="modal-dialog h-75 modal-lg modal-dialog-centered" role="document">
            <div class="modal-content h-75">
                <div class="modal-header">
                    <h5 class="modal-title f-roboto b">
                        <i class="bi bi-stickies"></i>&nbsp;
						<% if (user.LanguageContext == "IT") { %>
                            Versioni
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Versions
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Versiones
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            版本
                        <% } %>
                        / <span class="model-header"></span>
                    </h5>
                    <button type="button" class="btn-close btn-cancel-history" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="h-50" style="overflow-y:auto;">
                        <table class="table table-hover table-xs">
                            <thead>
                                <tr>
                                    <th scope="col">
                                    </th>
                                    <th scope="col" class="process-label-id">
					                    <% if (user.LanguageContext == "IT") { %>
                                            Versione
                                        <% } %>
                                        <% if (user.LanguageContext == "GB") { %>
                                            Version
                                        <% } %>
                                        <% if (user.LanguageContext == "ES") { %>
                                            ID
					                    <% } %>
                                        <% if (user.LanguageContext == "CN") { %>
                                            ID
                                        <% } %>
                                    </th>
                                    <th scope="col" class="hidden-xs">
					                    <% if (user.LanguageContext == "IT") { %>
                                            Data Registrazione
                                        <% } %>
                                        <% if (user.LanguageContext == "GB") { %>
                                            Creation date
                                        <% } %>
                                        <% if (user.LanguageContext == "ES") { %>
                                            Fecha de registro
					                    <% } %>
                                        <% if (user.LanguageContext == "CN") { %>
                                            註冊日期
                                        <% } %>
                                    </th>
                                    <th scope="col" class="hidden-xs">
					                    <% if (user.LanguageContext == "IT") { %>
                                            Ultima modifica
                                        <% } %>
                                        <% if (user.LanguageContext == "GB") { %>
                                            Creation date
                                        <% } %>
                                        <% if (user.LanguageContext == "ES") { %>
                                            Última modificaci&oacute;n
					                    <% } %>
                                        <% if (user.LanguageContext == "CN") { %>
                                            最後修改
                                        <% } %>
                                    </th>
                                    <th scope="col">
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="result-forms-version-container">
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xs-12 text-center">
                        <a class="btn btn-primary btn-circle bi bi-plus-lg btn-new-version" data-idversione=""></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" id="container-form-edit" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title f-roboto b">
                        <span class="ordine-idrecord-color px-1"></span> <i class="bi bi-sticky"></i>&nbsp;
                        <b>
                        <% if (user.LanguageContext == "IT") { %>
                        Modifica
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Edit
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        Editar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        編輯
                        <% } %></b> / <span class="form-header"></span>
                    </h5>
                    <button type="button" class="btn-close btn-cancel-container-form-edit" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="container-form-edit"></div>
                </div>

            </div>
        </div>
    </div>

    <div class="modal" id="container-form-new-version" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-lg h-75 modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h3 class="modal-title">
                        <span class="form-new-version-header f-roboto b" />
                    </h3>
                    <button type="button" class="btn-close btn-cancel-container-form-new-version" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="col-lg-5 col-md-5 col-sm-12 col-xs-12">
                        <img src="images/start-new-form-version.png" class="img-fluid" />
                    </div>
                    <div class="col-lg-7 col-md-7 col-sm-12 col-xs-12">
                        <h4>
                            <span class="form-new-version-header-sub text-primary f-roboto-b"></span>
                        </h4>
                        <h5 class="f-roboto lh-sm text-secondary">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. 
                        </h5>
                        <div class="col-xs-12 p-0">
                            <h5 class="f-roboto-b text-primary">
                                <% if (user.LanguageContext == "IT") { %>
                                    Duplica da versione precedente
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Duplicate from previous version
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Duplicado de la versi&oacute;n anterior
                                <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    複製自先前版本
                                <% } %>
                                
                            </h5>
                            <div class="col-xs-12 p-0 form-switch">
                                <input id="chkCopyFromPreviousVersion" name="chkCopyFromPreviousVersion" class="form-check-input" type="checkbox">
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer col-xs-12">
                    <button type="button" class="btn btn-success btn-success-form-new-version">OK</button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal" id="container-form-new" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-lg h-75 modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h3 class="modal-title">
                        <span class="form-new-header f-roboto b" />
                    </h3>
                    <button type="button" class="btn-close btn-cancel-container-form-new" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <img src="images/start-new-form-<%= user.LanguageContext %>.png" class="img-fluid" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <form id="frm-model-new" class="was-validated" novalidate>
                            <input type="hidden" id="txt-model-idmodello" name="txt-model-idmodello">
                            <div class="col-xs-12 p-0">
                                <div class="container-control-model-culture-textbox" />
                            </div>
                            <div class="col-xs-12 p-0">
                                <label for="txt-model-codice" class="col-form-label">
                                    <% if (user.LanguageContext == "IT") { %>
                                        Codice
                                    <% } %>
                                    <% if (user.LanguageContext == "GB") { %>
                                        Code
                                    <% } %>
                                    <% if (user.LanguageContext == "ES") { %>
                                        C&oacute;digo
                                    <% } %>
                                    <% if (user.LanguageContext == "CN") { %>
                                        程式碼
                                    <% } %>
                                </label>
                                <input type="text" class="form-control" id="txt-model-codice">
                            </div>
                        </form>
                    </div>

                </div>

                <div class="modal-footer col-xs-12">
                    <button type="button" class="btn btn-success btn-success-form-new">OK</button>
                </div>

            </div>
        </div>
    </div>

    <TitoloForm style="display: none;">
		<% if (user.LanguageContext == "IT") { %>
            Imposta il titolo
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            Set the title
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            Establecer el t&iacute;tulo
		<% } %>
        <% if (user.LanguageContext == "CN") { %>
            設定標題
        <% } %>
    </TitoloForm>

    <LabelFormNew>
        <% if (user.LanguageContext == "IT") { %>
            Inizia creando una nuova form
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            Start by creating a new form
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            Empieza creando un nuevo formulario
        <% } %>
        <% if (user.LanguageContext == "CN") { %>
            首先建立一個新表單。
        <% } %>
    </LabelFormNew>

    <LabelFormNewVersion>
        <% if (user.LanguageContext == "IT") { %>
            Crea una nuova versione del form
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            Create a new form version
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            Cree una nueva versi&oacute;n del formulario
        <% } %>
        <% if (user.LanguageContext == "CN") { %>
            创建表单的新版本
        <% } %>
    </LabelFormNewVersion>

    <LabelFormEdit>
        <% if (user.LanguageContext == "IT") { %>
            Modifica il titolo della form
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            Edit form title
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            Editar el t&iacute;tulo del formulario
        <% } %>
        <% if (user.LanguageContext == "CN") { %>
            編輯表單標題
        <% } %>
    </LabelFormEdit>

    <LabelDescrizione style="display: none;">
		<% if (user.LanguageContext == "IT") { %>
            Descrizione
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            Description
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            Descripci&oacute;n
		<% } %>
        <% if (user.LanguageContext == "CN") { %>
            描述
        <% } %>
    </LabelDescrizione>

    <%- include('partials/system-message'); %>

</body>
</html>