        <div class="modal" id="container-workflow" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title f-roboto b">
                            Workflow
                        </h4>
                        <button type="button" class="btn-close btn-cancel-container-workflow" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <span class="spinner-border text-info mt-3 spinner-workflow" role="status" style="display:none; position:absolute; left:50%;"></span>
                        <div id="tooltip"></div>
                        <div id="cy" style="width:100%; height: 700px; border:1px solid #e3e3e3; z-index:1000; border-radius: 2px;"></div>
                        <button type="button" class="btn btn-primary rounded-circle glyphicon glyphicon-plus btn-workflow-states-new"
                            style="width:34px; height:34px; padding:0; margin:10px; left:20px; top:20px; position: absolute; z-index:1000;">
                        </button>
                        <button class="btn btn-default bi bi-printer workflow-stampa" style="margin:10px; left:60px; top:20px; position: absolute; z-index:1000;"></button>
                        <button class="btn btn-default bi bi-download workflow-download" style="margin:10px; left:105px; top:20px; position: absolute; z-index:1000;"></button>
                        <div id="context-menu-node">
                            <input type="hidden" class="node" />
                            <input type="hidden" id="IdEventoTransizione" />
                            <input type="hidden" id="DescTransizione" />
                            <h6 class="col-xs-12 p-0 px-2 f-roboto-b text-primary context-menu-node-header"></h6>
                            <button type="button" class="btn-close btn-xs btn-cancel-context-menu-node"></button>
                            <h6 class="col-xs-12 p-0 m-0"><div class="divider"></div></h6>
                            <span class="col-xs-12 p-0 px-2 workflow-set-owner">
                                <i class="bi bi-person-gear"></i>&nbsp;&nbsp;
		                        <% if (user.LanguageContext == "IT") { %>
                                    Imposta owner
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Set owner
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Establecer propietario
		                        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    設定所有者
                                <% } %>
                            </span>
                            <span class="col-xs-12 p-0 px-2 workflow-set-auth">
                                <i class="bi bi-person-lock"></i>&nbsp;&nbsp;
		                        <% if (user.LanguageContext == "IT") { %>
                                    Imposta autorizzazioni
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Set permissions
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Establecer permisos
		                        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    設定權限
                                <% } %>
                            </span>
                            <span class="col-xs-12 p-0 px-2 workflow-set-rel">
                                <i class="bi bi-link-45deg"></i>&nbsp;&nbsp;
		                        <% if (user.LanguageContext == "IT") { %>
                                    Collega stato
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Link node
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Establecer permisos
		                        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    設定權限
                                <% } %>
                            </span>
                            <span class="col-xs-12 p-0 px-2 workflow-set-node">
                                <i class="bi bi-pencil"></i>&nbsp;&nbsp;
		                        <% if (user.LanguageContext == "IT") { %>
                                    Modifica
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Edit
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Editar
		                        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    編輯
                                <% } %>
                            </span>
                            <span class="col-xs-12 p-0 px-2 workflow-del-node">
                                <i class="bi bi-trash"></i>&nbsp;&nbsp;
		                        <% if (user.LanguageContext == "IT") { %>
                                    Elimina
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Delete
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Borrar
		                        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    刪除
                                <% } %>
                            </span>
                        </div>

                        <div id="context-menu-link">
                            <input type="hidden" class="transition" />
                            <input type="hidden" id="IDEventoDirezione" />
                            <input type="hidden" id="DescDirezione" />
