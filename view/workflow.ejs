                        </h5>
                        <span class="spinner-border text-info mt-3 spinner-node-workflow-owner" role="status" style="float:right; display:none; position:absolute; left:92%;"></span>
                        <button type="button" class="btn-close btn-cancel-container-workflow-set-owner" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <!-- TODO: traduzione -->
                    <div class="modal-body">
                        <div class="container-fluid p-0">
                            <div class="col-xs-12 p-0 form-switch">
                                <input class="form-check-input btn-toggle-" type="checkbox" id="rb-IsCreator" name="rb-IsCreator">
                                &nbsp; Utente che ha creato l'oggetto
                            </div>
                            <div class="col-xs-12 p-0 form-switch">
                                <input class="form-check-input btn-toggle-" type="checkbox" id="rb-IsAdminOfCreator" name="rb-IsAdminOfCreator">
                                &nbsp; Responsabile dell'utente che ha creato l'oggetto
                            </div>
                            <div class="col-xs-12 p-0 form-switch">
                                <input type="hidden" id="IsAdminOwnerSelectedNode_Id" />
                                <input class="form-check-input btn-toggle-" type="checkbox" id="rb-IsAdminOwnerSelectedNode" name="rb-IsAdminOwnerSelectedNode">
                                &nbsp; Responsabile del proprietario dello stato <span id="IsAdminOwnerSelectedNode_Desc"></span>
                                <i class="bi bi-gear btn btn-default btn-xs bi-gear-is-admin-ownwer-selected-node"></i>
                            </div>
                            <div class="col-xs-12 p-0 form-switch">
                                <input type="hidden" id="IsOwnerSelectedNode_Id" />
                                <input class="form-check-input btn-toggle-" type="checkbox" id="rb-IsOwnerSelectedNode" name="rb-IsOwnerSelectedNode">
                                &nbsp; Proprietario dello stato <span id="IsOwnerSelectedNode_Desc"></span>
                                <i class="bi bi-gear btn btn-default btn-xs bi-gear-is-ownwer-selected-node"></i>
                            </div>
                            <div class="col-xs-12 p-0 form-switch">
                                <input type="hidden" id="IsCreatorSelectedNode_Id" />
                                <input class="form-check-input btn-toggle-" type="checkbox" id="rb-IsCreatorSelectedNode" name="rb-IsCreatorSelectedNode">
                                &nbsp; Utente che ha registrato lo stato <span id="IsCreatorSelectedNode_Desc"></span>
                                <i class="bi bi-gear btn btn-default btn-xs bi-gear-is-creator-selected-node"></i>
                            </div>
                            <div class="col-xs-12 p-0 form-switch">
                                <input type="hidden" id="IsSelectedProfile_Id" />
                                <input class="form-check-input btn-toggle-" type="checkbox" id="rb-IsSelectedProfile" name="rb-IsSelectedProfile">
                                &nbsp; Utenti del profilo <span id="IsSelectedProfile_Desc"></span>
                                <i class="bi bi-gear btn btn-default btn-xs bi-gear-is-selected-profile"></i>
                            </div>
                            <div class="col-xs-12 p-0 form-switch">
                                <input class="form-check-input btn-toggle-" type="checkbox" id="rb-IsUsersFromAdminProfileCreator" name="rb-IsUsersFromAdminProfileCreator">
                                &nbsp; Utenti del profilo associato all'utente che ha creato l'oggetto
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary btn-confirm-container-workflow-set-owner">
                            OK
                        </button>
                        <button type="button" data-bs-dismiss="modal" class="btn btn-default btn-cancel-container-workflow-set-owner">
		                    <% if (user.LanguageContext == "IT") { %>
                                Annulla
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Cancel
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                Cancelar
		                    <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                取消
                            <% } %>
                        </button>
                    </div>
                </div>
            </div>
        </div>

