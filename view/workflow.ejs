		                        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    設定連結
                                <% } %>
                            </span>
                            <span class="col-xs-12 p-0 px-2 workflow-del-link">
                                <i class="bi bi-trash"></i>&nbsp;&nbsp;
		                        <% if (user.LanguageContext == "IT") { %>
                                    Elimina
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                    Delete
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                    Borrar
		                        <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                    刪除
                                <% } %>
                            </span>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" data-bs-dismiss="modal" class="btn btn-default btn-cancel-container-workflow">Annulla</button>
                    </div>
                </div>
            </div>
