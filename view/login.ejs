<!DOCTYPE html>
<html>
<head>
    <title>Web APP DC - Login</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%- include('partials/head'); %>
    <script type="text/javascript" src="/utility-script"></script>
    <script type="text/javascript" src="/validation-script"></script>
    <script type="text/javascript" src="/login-script"></script>
</head>
<body class="bg-light">
    <form name="frmLogin" id="frmLogin" method="POST" action="/login" class="was-validated" novalidate>
        <input type="hidden" name="LanguageContext" id="LanguageContext" value="<%= LanguageContext %>" />
        <div class="container min-vh-100 d-flex justify-content-center align-items-center py-4">
            <div class="row justify-content-center w-100">
                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5" style="max-width: 520px;">
                    <div class="card login border shadow-sm position-relative">
                        <div id="select-container" class="position-absolute top-0 end-0 m-3 z-3" style="left: auto; transform: none;">
                            <ul>
                            <li class="IT" lang-selection="IT" tooltip="IT" flow="down">
                                <img src="/images/flags/it.svg" alt="IT">
                            </li>
                            <!--li class="ES" lang-selection="ES" tooltip="ES" flow="down">
                                <img src="/images/flags/es.svg" alt="ES">
                            </li-->
                            <!--li class="CN" lang-selection="CN" tooltip="CN" flow="down">
                                <img src="/images/flags/cn.svg" alt="CN">
                            </li-->
                            <li class="GB" lang-selection="GB" tooltip="GB" flow="down">
                                <img src="/images/flags/gb.svg" alt="GB">
                            </li>
                            </ul>
                        </div>
                        <div class="card-body p-4 pt-3">
                            <div class="text-center mb-3">
                                <img src="/images/dc-login.png" class="img-fluid" alt="DC Web Platform">
                            </div>

                            <% if (error) { %>
                                <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                                    <div><%= error %></div>
                                </div>
                            <% } %>

                            <div class="mb-3">
                                <label for="Userid" class="form-label">
                                    <% if (LanguageContext == "IT") { %>
                                        La tua e-mail
                                    <% } else if (LanguageContext == "GB") { %>
                                        Your e-mail
                                    <% } else if (LanguageContext == "ES") { %>
                                        Tu correo electr&oacute;nico
                                    <% } else if (LanguageContext == "CN") { %>
                                        手机号码
                                    <% } %>
                                </label>
                                <input class="form-control" type="text" name="Userid" id="Userid" required value="francesco@dcgroupitalia.com">
                            </div>

                            <div class="mb-4">
                                <label for="Password" class="form-label">
                                    <% if (LanguageContext == "IT") { %>
                                        Password
                                    <% } else if (LanguageContext == "GB") { %>
                                        Password
                                    <% } else if (LanguageContext == "ES") { %>
                                        Contrase&ntilde;a
                                    <% } else if (LanguageContext == "CN") { %>
                                        密码
                                    <% } %>
                                </label>
                                <div class="position-relative">
                                    <i class="btn bi bi-eye-slash-fill show-hide-password-login"></i>
                                    <input class="form-control" type="password" name="Password" id="Password" required maxlength="20" value="Admin123456789@">
                                </div>
                            </div>

                            <div class="row align-items-center pt-2">
                                <div class="col-6">
                                    <button type="submit" class="btn btn-primary btn-lg btn-login" style="background-color: #1763a1; border-color: #1763a1;">
                                        <% if (LanguageContext == "IT") { %>
                                            Accedi
                                        <% } else if (LanguageContext == "GB") { %>
                                            Sign In
                                        <% } else if (LanguageContext == "ES") { %>
                                            Iniciar sesi&oacute;n
                                        <% } else if (LanguageContext == "CN") { %>
                                            登录
                                        <% } %>
                                    </button>
                                </div>
                                <div class="col-6 text-end">
                                    <a href="/password-recovery/<%= LanguageContext %>" class="text-decoration-none">
                                        <% if (LanguageContext == "IT") { %>
                                            Password dimenticata?
                                        <% } else if (LanguageContext == "GB") { %>
                                            Lost password?
                                        <% } else if (LanguageContext == "ES") { %>
                                            Has perdido tu contrase&ntilde;a?
                                        <% } else if (LanguageContext == "CN") { %>
                                            忘记密码？
                                        <% } %>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</body>
</html>