%>
<!DOCTYPE html>
<html>
<head>
    <title>Web APP DC - <%= labels.title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%- include('partials/head'); %>
    <script type="text/javascript" src="/processi-script"></script>
    <script type="text/javascript" src="/control-pager-script"></script>
    <script type="text/javascript" src="/control-confirm-delete-script"></script>
    <script type="text/javascript" src="/utility-script"></script>
    <script type="text/javascript" src="/gestione-utenti-script"></script>
    <script type="text/javascript" src="/logout-script"></script>
</head>
<body class="forms-page">
    <%- include('partials/header'); %>
    <input type="hidden" id="LanguageContext" value="<%= user.LanguageContext %>">
    <input type="hidden" id="labels" value="<%= JSON.stringify(labels) %>">
    <div class="container-fluid p-0 px-4">
        <h4 class="p-0">
            <span class="bi bi-people-fill" style="font-size:2rem;"></span>&nbsp;
            <b class="f-roboto b"><%= labels.title %></b>
        </h4>
    </div>
    <div class="container-fluid forms-layout">
        <div class="filtro-container forms-filter">
            <div class="card h-100 p-0">
                <div class="card-header p-2 f-roboto">
                    <button type="button" class="btn btn-light bi bi-arrow-left rounded-circle float-end btn-30 btn-filter-close"
                        data-bs-toggle="tooltip" data-bs-trigger="manual" data-bs-title="<%= labels.hideFilter %>" aria-label="<%= labels.hideFilter %>"></button>
                    <b><%= labels.filter %></b>
                </div>
                <div class="card-body p-2 forms-filter-body">
                    <div class="tab-content mt-3">
                        <div class="tab-pane active">
                            <div id="filtro-forms-container">
                                <div class="mb-3">
                                    <label class="form-label" for="filter-nome"><%= labels.nome %></label>
                                    <input class="form-control" id="filter-nome" maxlength="50">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="filter-cognome"><%= labels.cognome %></label>
                                    <input class="form-control" id="filter-cognome" maxlength="50">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="filter-is-public"><%= labels.public %></label>
                                    <select class="form-select" id="filter-is-public">
                                        <option value=""><%= labels.all %></option>
                                        <option value="true"><%= labels.yes %></option>
                                        <option value="false"><%= labels.no %></option>
                                    </select>
                                </div>
                            </div>
                            <div class="forms-filter-actions p-3 pt-4">
                                <button type="button" class="btn btn-md btn-secondary text-white w-100 btn-filter-apply"><%= labels.search %></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="result-container forms-results">
            <div class="card h-100 p-0">
                <div class="card-header p-3 f-roboto">
                    <b><%= labels.users %></b>
                    <button type="button" class="btn btn-light bi bi-sliders rounded-circle float-end btn-30 btn-filter-open"
                        data-bs-toggle="tooltip" data-bs-trigger="manual" data-bs-title="<%= labels.showFilter %>" aria-label="<%= labels.showFilter %>"></button>
                    <button type="button" class="btn btn-primary btn-sm float-end me-2 btn-user-new" disabled>
                        <i class="bi bi-plus-lg"></i>&nbsp;<%= labels.newUser %>
                    </button>
                </div>
                <div class="card-body p-2 f-roboto">
                    <div class="forms-results-content">
                        <div class="table-responsive">
                            <table class="table table-hover table-xs users-table">
                                <thead>
                                    <tr>
                                        <th class="users-column-id"><%= labels.id %></th>
                                        <th><%= labels.nome %></th>
                                        <th><%= labels.cognome %></th>
                                        <th><%= labels.birthDate %></th>
                                        <th class="users-column-detail"><%= labels.fiscalCode %></th>
                                        <th class="users-column-detail"><%= labels.gender %></th>
                                        <th class="users-column-detail"><%= labels.public %></th>
                                        <th class="users-column-detail"><%= labels.recordDate %></th>
                                        <th class="users-actions"></th>
                                    </tr>
                                </thead>
                                <tbody class="result-utenti-container"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="forms-pager-container">
                        <div class="utenti-pager pager p-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" id="container-user-edit" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form id="frm-user-edit" class="was-validated" novalidate>
                    <div class="modal-header">
                        <h5 class="modal-title f-roboto b" id="user-edit-title"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= labels.cancel %>"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <div class="form-check form-switch p-0">
                                    <input class="form-check-input" type="checkbox" id="user-is-public">&nbsp;
                                    <label class="form-check-label text-dark" for="user-is-public"><%= labels.public %></label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="user-nome"><%= labels.nome %></label>
                                <input class="form-control" id="user-nome" maxlength="50" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="user-cognome"><%= labels.cognome %></label>
                                <input class="form-control" id="user-cognome" maxlength="50" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="user-data-nascita"><%= labels.birthDate %></label>
                                <input class="form-control" id="user-data-nascita" type="text" autocomplete="off">
                                <div class="invalid-feedback"><%= labels.invalidDate %></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="user-codice-fiscale"><%= labels.fiscalCode %></label>
                                <input class="form-control" id="user-codice-fiscale" maxlength="16">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="user-sesso"><%= labels.gender %></label>
                                <input class="form-control" id="user-sesso" maxlength="10">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= labels.cancel %></button>
                        <button type="submit" class="btn btn-primary" id="btn-user-save"><%= labels.save %></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal" id="container-user-account" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="frm-user-account" class="was-validated" novalidate>
                    <div class="modal-header">
                        <h5 class="modal-title f-roboto b"><%= labels.accountTitle %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= labels.cancel %>"></button>
                    </div>
                    <div class="modal-body">
                        <div id="user-account-delete-error" class="alert alert-danger d-none" role="alert" aria-live="assertive"></div>
                        <div class="user-account-options mb-3">
                            <div class="form-check form-switch d-flex align-items-center gap-2">
                                <input class="form-check-input m-0" type="checkbox" id="user-account-is-public">
                                <label class="form-check-label text-dark" for="user-account-is-public"><%= labels.public %></label>
                            </div>
                            <div class="form-check form-switch d-flex align-items-center gap-2">
                                <input class="form-check-input m-0" type="checkbox" id="user-account-is-visible">
                                <label class="form-check-label text-dark" for="user-account-is-visible"><%= labels.visible %></label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="user-account-email"><%= labels.email %></label>
                            <input class="form-control" id="user-account-email" type="email" maxlength="50" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="user-account-password"><%= labels.password %></label>
                            <div class="position-relative user-account-password-wrap">
                                <i class="btn bi bi-eye-slash-fill show-hide-password"></i>
                                <input class="form-control" id="user-account-password" type="password" maxlength="15" readonly>
                            </div>
                            <small class="form-text text-secondary" id="user-account-password-note"></small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= labels.cancel %></button>
                        <button type="button" class="btn btn-danger" id="btn-user-account-delete" disabled aria-disabled="true"><%= labels.delete %></button>
                        <button type="submit" class="btn btn-primary" id="btn-user-account-save"><%= labels.save %></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div id="container-confirm-delete-user"></div>
    <style>
        .users-table {
            min-width: 1100px;
        }
        .ui-datepicker {
            z-index: 2000 !important;
        }
        .user-account-options {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 1.5rem;
        }
        .user-account-options .form-check {
            padding-left: 0;
        }
        .user-account-password-wrap .form-control {
            padding-right: 2.5rem;
        }
        .user-account-password-wrap .show-hide-password {
            position: absolute;
            top: 50%;
            right: .75rem;
            left: auto;
            z-index: 2;
            margin: 0;
            padding: 0;
            transform: translateY(-50%);
            color: #495057;
            background: transparent;
            border: 0;
            font-size: 1rem;
            line-height: 1;
            cursor: pointer;
        }
        @media (max-width: 991.98px), (max-width: 1366px) and (orientation: portrait) {
            .users-table {
                min-width: 0;
            }
            .users-column-id,
            .users-column-detail {
                display: none;
            }
            .users-actions {
                width: 1%;
                white-space: nowrap;
            }
        }
    </style>
</body>
</html>
