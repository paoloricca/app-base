<tr>
    <td scope="col">
        <i class="bi bi-circle-fill" style="" />
    </td>
    <td scope="col">
        <%= row.Numero %>
    </td>
    <td scope="col">
        <%= row.DataRegistrazione %>
    </td>
    <td scope="col" class="d-none d-md-table-cell">
        <%= row.DataUltimaModifica %>
    </td>
    <td scope="col" class="text-end">
        <div class="container-model-edit-<%= row.IDVersione %>">

            <div class="col-12 text-end p-0 versione-<%= row.IDVersione %>">
                <div class="btn-group context-menu-model forms-context-menu-container">
                    <button type="button" data-idrecord="<%= row.IDVersione %>" class="btn btn-light bi bi-three-dots-vertical btn-actions rounded-circle btn-workflow-<%= row.IDVersione %> forms-context-menu-trigger"
                        data-bs-toggle="dropdown"
                        data-bs-placement="left" data-bs-title="<% if (LanguageContext == "IT") { %>Azioni<% } %><% if (LanguageContext == "GB") { %>Actions<% } %><% if (LanguageContext == "ES") { %>Comportamiento<% } %><% if (LanguageContext == "CN") { %>行動<% } %>">
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end forms-context-menu app-context-menu">
                        <li>
                            <div class="forms-context-menu-heading app-context-menu-heading">
                                <b>
                                    ID: <%= row.IDVersione %>
                                </b>
                                <span class="spinner-border text-danger" role="status" style="display:none;"></span>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
							<span class="dropdown-item forms-context-menu-action btn-model-versions">
								<i class="bi bi-zoom-in"></i>
							    <% if (LanguageContext == "IT") { %>
                                    Anteprima
                                <% } %>
                                <% if (LanguageContext == "GB") { %>
                                    Preview
                                <% } %>
                                <% if (LanguageContext == "ES") { %>
                                    Versiones
                                <% } %>
                                <% if (LanguageContext == "CN") { %>
                                    版本
                                <% } %>
                            </span>
                        </li>
						<li>
							<span class="dropdown-item forms-context-menu-action btn-model-edit-<%= row.IDVersione %>" data-idmodello="<%= row.IDModello %>" data-idversione="<%= row.IDVersione %>">
							    <i class="bi bi-pencil"></i>
							    <% if (LanguageContext == "IT") { %>
                                        Modifica
                                <% } %>
                                <% if (LanguageContext == "GB") { %>
                                    Edit
                                <% } %>
                                <% if (LanguageContext == "ES") { %>
                                    Editar
                                <% } %>
                                <% if (LanguageContext == "CN") { %>
                                    編輯
                                <% } %>
							</span>
						</li>
                        <li>
							<span class="dropdown-item forms-context-menu-action btn-model-del-<%= row.IDVersione %>" data-idversione="<%= row.IDVersione %>">
								<i class="bi bi-trash"></i>
								<% if (LanguageContext == "IT") { %>
                                    Elimina
                                <% } %>
                                <% if (LanguageContext == "GB") { %>
                                    Delete
                                <% } %>
                                <% if (LanguageContext == "ES") { %>
                                    Borrar
                                <% } %>
                                <% if (LanguageContext == "CN") { %>
                                    刪除
                                <% } %>
							</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </td>
</tr>