<div class="processo-azione-<%= processoazione.IDProcessoAzione %>-container p-0">
    <div class="col-xs-12 p-0 process-bg">
        <div class="col-xs-9 p-0 text-start">
            <span class="text-start text-decoration-none p-0 px-2 text-secondary f-roboto" data-idprocessoazione="<%= processoazione.IDProcessoAzione %>">
                <%= processoazione.Description %>
            </span>
        </div>
        <div class="col-xs-3 text-end p-0 form-switch">
            <input class="form-check-input me-2 btn-toggle-processo-azione-<%= processoazione.IDProcessoAzione %>" type="checkbox"
            <% if (processoazione.IdProcesso != undefined) { %> checked <% } %>
            id="rb-processo-azione-<%= processoazione.IDProcessoAzione %>" name="rb-processo-azione-<%= processoazione.IDProcessoAzione %>">
        </div>
    </div>
</div>