<!-- BOOLEAN -->
<div class="col-6 p-0 mb-2 px-3">
	<% if (mode == "design") { %>
	<a class="btn btn-light bi bi-three-dots-vertical btn-actions btn-circle m-1 ms-0 model-editor-menu-trigger"
		data-bs-toggle="dropdown"
	 data-bs-placement="left">
	</a>
	<ul class="dropdown-menu model-editor-context-menu">
		<li>
			<div class="model-editor-context-menu-heading">
				<b>
					<%= row.Description %>
				</b>
                <span class="spinner-border text-danger" role="status" style="display:none;"></span>
			</div>
		</li>
		<li><hr class="dropdown-divider"></li>
		<li>
			<span class="dropdown-item model-editor-context-menu-action btn-menu-item btn-attribute-<%= row.IDAttributo %>-edit"
				data-idattributo="<%= row.IDAttributo %>" 
				data-idtipodati="<%= row.IDTipoDati %>">
				<i class="bi bi-pencil"></i>
				<% if (user.LanguageContext == "IT") { %>
						Modifica
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                        Edit
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                        Editar
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                        編輯
                    <% } %>
			</span>
		</li>
		<li>
			<span class="dropdown-item model-editor-context-menu-action btn-menu-item btn-attribute-<%= row.IDAttributo %>-del"
				data-idattributo="<%= row.IDAttributo %>" 
				data-idtipodati="<%= row.IDTipoDati %>">
				<i class="bi bi-trash"></i>
				<% if (user.LanguageContext == "IT") { %>
                        Elimina
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                        Delete
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                        Borrar
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                        刪除
                    <% } %>
			</span>
		</li>
	</ul>
	<% } %>
	<label for="control_<%= row.IDAttributo %>" class="col-form-label"><%= row.Description %></label>
	<div class="col-12 p-0">
	<div class="form-check p-0 form-check-inline">
		<input data-idtipodati="<%= row.IDTipoDati %>" data-idattributo="<%= row.IDAttributo %>"
			class="form-check-input me-2" <% if (row.Obbligatorio) { %> required<% } %> type="radio" name="control_<%= row.IDAttributo %>" id="control_<%= row.IDAttributo %>_0" value="0">
		<label class="col-form-label" for="control_<%= row.IDAttributo %>_0">
            <% if (user.LanguageContext == "IT") { %>
            No
            <% } %>
            <% if (user.LanguageContext == "GB") { %>
            No
            <% } %>
            <% if (user.LanguageContext == "ES") { %>
            No
            <% } %>
            <% if (user.LanguageContext == "CN") { %>
            不
            <% } %>
		</label>
	</div>
	<div class="form-check p-0 form-check-inline">
		<input data-idtipodati="<%= row.IDTipoDati %>" data-idattributo="<%= row.IDAttributo %>"
			class="form-check-input me-2" <% if (row.Obbligatorio) { %> required<% } %> type="radio" name="control_<%= row.IDAttributo %>" id="control_<%= row.IDAttributo %>_1" value="1">
		<label class="col-form-label" for="control_<%= row.IDAttributo %>_1">
            <% if (user.LanguageContext == "IT") { %>
            Si
            <% } %>
            <% if (user.LanguageContext == "GB") { %>
            Yes
            <% } %>
            <% if (user.LanguageContext == "ES") { %>
            S&iacute;
            <% } %>
            <% if (user.LanguageContext == "CN") { %>
            是的
            <% } %>
		</label>
	</div>
	</div>
</div>