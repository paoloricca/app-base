<div class="col-xs-12 p-0 mb-2 px-3">
    <label for="control_<%= row.ColumnName %>" class="col-form-label">
		<% if (user.LanguageContext == "IT") { %>
            <%= row.Description_IT %>
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            <%= row.Description_GB %>
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            <%= row.Description_ES %>
		<% } %>
        <% if (user.LanguageContext == "CN") { %>
            <%= row.Description_CN %>
        <% } %>
    </label>
    <input type="text" 
    data-idattributo="<%= row.ColumnName %>"
    data-idtipodati="<%= row.DataType %>"
    class="form-control" id="control_<%= row.ColumnName %>" 
    maxlength="<%= row.maxlength %>">
</div>