<div class="row g-0 align-items-center p-2 px-2 item-bg">
    <div class="col-7 p-0">
        <span class="c-base f-roboto utente-<%= utente.IDAccount %>" data-idaccount="<%= utente.IDAccount %>">
            <%= utente.Nominativo %>
        </span>
    </div>
    <div class="col-3">
        <div class="form-check form-switch m-0">
            <input data-default="<%= utente.IsDefault %>" <% if (utente.IsDefault == 1) { %> checked <% } %>
                style="display:none;" class="form-check-input p-0 m-0 btn-set-profilo-utente-default-<%= utente.IDAccount %>" type="checkbox" id="ProfiloUtente-rbIsVisible" name="rbIsVisible">
        </div>
    </div>
    <div class="col-2 text-end">
        <div class="utenti">
            <a href="#" class="btn btn-outline-secondary btn-sm btn-select-<%= utente.IDAccount %>">Collega</a>
        </div>
        <div class="utenti">
            <a href="#" style="display:none;" 
            data-args="<%= utente.IDAccount %>"
            class="btn btn-outline-secondary btn-sm btn-unselect-<%= utente.IDAccount %>">Scollega</a>
        </div>
    </div>
</div>