<div class="processo-<%= processo.IDProc %>-container">
    <div class="w-100 p-0 process-bg">
        <div class="d-flex align-items-center w-100 p-1 text-start btn btn-processo-<%= processo.IDProc %>">
            <a class="flex-grow-1 text-start btn p-0 text-secondary f-roboto" style="min-width:0; overflow-wrap:anywhere;" data-idprocesso="<%= processo.IDProc %>">
                <%= processo.Description %>
            </a>
            <% if (processo.HasWorkflow === true || processo.HasWorkflow === 1 || processo.HasWorkflow === '1') { %>
                <i class="bi bi-bezier2 flex-shrink-0 ms-2 me-1" aria-hidden="true"></i>
            <% } %>
            <% if (contextMenu) { %>
                <div class="btn-group ms-auto flex-shrink-0 processo-context-dropdown">
                    <button type="button" class="btn btn-light bi bi-three-dots-vertical processi-context-trigger"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= contextMenu.actions %>"></button>
                    <ul class="dropdown-menu dropdown-menu-end app-context-menu">
                        <li>
                            <div class="app-context-menu-heading"><b><%= processo.Description %></b></div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button type="button" class="dropdown-item p-2"><i class="bi bi-pencil"></i>&nbsp;&nbsp;<%= contextMenu.edit %></button></li>
                        <li><button type="button" class="dropdown-item p-2 processi-custom-actions"
                            data-idprocesso="<%= processo.IDProc %>"
                            data-process-description="<%= processo.Description %>"><i class="bi bi-lightning"></i>&nbsp;&nbsp;<%= contextMenu.customActions %></button></li>
                        <li><button type="button" class="dropdown-item p-2"><i class="bi bi-trash"></i>&nbsp;&nbsp;<%= contextMenu.delete %></button></li>
                        <li><button type="button" class="dropdown-item p-2"><i class="bi bi-x-lg"></i>&nbsp;&nbsp;<%= contextMenu.cancel %></button></li>
                    </ul>
                </div>
            <% } %>
        </div>
    </div>
</div>