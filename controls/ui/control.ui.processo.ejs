<div class="processo-<%= processo.IDProc %>-container">
    <div class="w-100 p-0 process-bg">
        <div class="d-flex align-items-center w-100 p-1 text-start btn btn-processo-<%= processo.IDProc %>">
            <a class="flex-grow-1 text-start btn p-0 text-secondary f-roboto" style="min-width:0; overflow-wrap:anywhere;" data-idprocesso="<%= processo.IDProc %>">
                <%= processo.Description %>
            </a>
            <% if (processo.HasWorkflow) { %>
                <i class="bi bi-bezier2 flex-shrink-0 ms-2 me-1" aria-hidden="true"></i>
            <% } %>
        </div>
    </div>
</div>