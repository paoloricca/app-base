<div class="col-xs-12 p-0 process-bg" style="">
    <div class="col-xs-12 p-1 text-start btn btn-value-<%= value.IDValue %>-edit">
        <a class="text-start btn p-0 ps-2 text-secondary f-roboto lbl-value-<%= value.IDValue %>-edit" data-idvalue="<%= value.IDValue %>">
            <%= value.Description %>
        </a>
        <a class="btn btn-light bi bi-three-dots-vertical btn-actions rounded-circle float-start"
		    data-toggle="dropdown" style="width:23px; height:23px; padding:0; font-size:1.1em;"
		    data-bs-toggle="tooltip" data-bs-placement="left">
	    </a>
	    <ul class="dropdown-menu dropdown-menu-left">
		    <li>
			    <div class="col-xs-12">
				    <b>
					    <%= value.Description %>
				    </b>
			    </div>
			    <span class="spinner-border text-danger mt-1" role="status" style="float:right; display:none; position:absolute; left:92%;"></span>
		    </li>
		    <li class="dropdown-item">
			    <hr class="dropdown-divider">
                </li>
		    <li class="dropdown-item">
			    <span class="col-xs-12 p-2 px-2 btn-menu-item btn-value-<%= value.IDValue %>-edit" data-idvalue="<%= value.IDValue %>">
				    <i class="bi bi-pencil"></i>&nbsp;&nbsp;
				    <% if (user.LanguageContext == "IT") { %>
						    Modifica
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Edit
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Editar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            編輯
                        <% } %>
			    </span>
		    </li>
		    <li class="dropdown-item">
			    <span class="col-xs-12 p-2 px-2 btn-menu-item btn-value-<%= value.IDValue %>-del" data-idvalue="<%= value.IDValue %>">
				    <i class="bi bi-trash"></i>&nbsp;&nbsp;
				    <% if (user.LanguageContext == "IT") { %>
                            Elimina
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Delete
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Borrar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            刪除
                        <% } %>
			    </span>
		    </li>
	    </ul>

    </div>
</div>