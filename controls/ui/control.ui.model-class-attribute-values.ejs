<div class="col-12 p-0 process-bg" style="">
    <div class="col-12 p-1 text-start btn btn-value-<%= value.IDValue %>-edit">
        <a class="text-start btn p-0 ps-2 text-secondary f-roboto lbl-value-<%= value.IDValue %>-edit" data-idvalue="<%= value.IDValue %>">
            <%= value.Description %>
        </a>
        <a class="btn btn-light bi bi-three-dots-vertical btn-actions rounded-circle float-start model-editor-menu-trigger"
		    data-bs-toggle="dropdown"
		    data-bs-placement="left">
	    </a>
	    <ul class="dropdown-menu model-editor-context-menu app-context-menu">
		    <li>
			    <div class="model-editor-context-menu-heading app-context-menu-heading">
				    <b>
					    <%= value.Description %>
				    </b>
                    <span class="spinner-border text-danger" role="status" style="display:none;"></span>
			    </div>
		    </li>
		    <li><hr class="dropdown-divider"></li>
		    <li>
			    <span class="dropdown-item model-editor-context-menu-action btn-menu-item btn-value-<%= value.IDValue %>-edit" data-idvalue="<%= value.IDValue %>">
				    <i class="bi bi-pencil"></i>
				    <% if (user.LanguageContext == "IT") { %>
						    Modifica
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Edit
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Editar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            編輯
                        <% } %>
			    </span>
		    </li>
		    <li>
			    <span class="dropdown-item model-editor-context-menu-action btn-menu-item btn-value-<%= value.IDValue %>-del" data-idvalue="<%= value.IDValue %>">
				    <i class="bi bi-trash"></i>
				    <% if (user.LanguageContext == "IT") { %>
                            Elimina
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Delete
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Borrar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            刪除
                        <% } %>
			    </span>
		    </li>
	    </ul>

    </div>
</div>