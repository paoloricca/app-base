<div class="modal modal-confirm-delete" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="ModalConfirmDelete">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    <span class="f-roboto b">
                        <% if (LanguageContext == "IT") { %>
                            Conferma operazione
                        <% } %>
                        <% if (LanguageContext == "GB") { %>
                            Confirm operation 
                        <% } %>
                        <% if (LanguageContext == "ES") { %>
                            Confirmar operaci&oacute;n
                        <% } %>
                        <% if (LanguageContext == "CN") { %>
                            確認操作
                        <% } %>
                    </span>
                </h4>
                <i class="bi bi-exclamation-triangle-fill text-danger ms-auto h4 p-0 m-0"></i>
            </div>
            <div class="modal-body">
                <h5 class="f-roboto-n text-dark lh-base m-0">
                        <% if (LanguageContext == "IT") { %>
                            Attenzione: l&apos;operazione non pu&ograve; essere annullata, confermi di voler procedere?
                        <% } %>
                        <% if (LanguageContext == "GB") { %>
                            Warning: this operation cannot be undone, do you confirm that you want to proceed?
                        <% } %>
                        <% if (LanguageContext == "ES") { %>
                            Advertencia: esta operaci&oacute;n no se puede deshacer; confirma que desea continuar?
                        <% } %>
                        <% if (LanguageContext == "CN") { %>
                            警告：此操作無法撤銷；您確定要繼續嗎？
                        <% } %>
                </h5>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default btn-cancel-delete" data-bs-dismiss="modal">
		            <% if (LanguageContext == "IT") { %>
                        Annulla
                    <% } %>
                    <% if (LanguageContext == "GB") { %>
                        Cancel
                    <% } %>
                    <% if (LanguageContext == "ES") { %>
                        Cancelar
		            <% } %>
                    <% if (LanguageContext == "CN") { %>
                        取消
                    <% } %>
                </button>
                <a class="btn btn-danger btn-ok-delete" data-dismiss="modal">
		            <% if (LanguageContext == "IT") { %>
                        Elimina
                    <% } %>
                    <% if (LanguageContext == "GB") { %>
                        Delete
                    <% } %>
                    <% if (LanguageContext == "ES") { %>
                        Borrar
		            <% } %>
                    <% if (LanguageContext == "CN") { %>
                        刪除
                    <% } %>
                </a>
            </div>
        </div>
    </div>
</div>