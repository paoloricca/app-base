<form id="frm-class-<%= row.IDClasse %>" class="was-validated" novalidate>
	<div data-fieldlist="" class="col-12 border border-1 p-2 mt-2 rounded model-class-<%= row.IDClasse %>-container">
		<div class="spinner-border text-primary mt-3" role="status"></div>
		<div class="card border-success mb-0 mt-3" style="display:none;">
			<div class="card-header text-bg-success">
                <% if (LanguageContext == "IT") { %>
                    Salvataggio effettuato
                <% } %>
                <% if (LanguageContext == "GB") { %>
                    Successfully saved
                <% } %>
                <% if (LanguageContext == "ES") { %>
                    Guardado exitosamente
                <% } %>
                <% if (LanguageContext == "CN") { %>
                    保存成功
                <% } %>
			</div>
		</div>
		<div class="col-12 text-start p-0 f-roboto b p-2 mb-2 mt-2 ps-3 process-bg">
            <a class="btn fs-3 bi bi-folder-minus btn-minus-plus-<%= row.IDClasse %> p-0 ps-1 pe-1 me-1">
	        </a>
            <a style="display: none;" class="btn btn-light bi bi-three-dots-vertical btn-actions btn-circle-xs m-0 float-end btn-edit-class-<%= row.IDClasse %> model-editor-menu-trigger"
		        data-bs-toggle="dropdown"
		        data-bs-placement="right">
	        </a>
	        <ul class="dropdown-menu dropdown-menu-end model-editor-context-menu app-context-menu">
		        <li>
			        <div class="model-editor-context-menu-heading app-context-menu-heading">
				        <b>
					        <%= row.Description %>
				        </b>
                        <span class="spinner-border text-danger" role="status" style="display:none;"></span>
			        </div>
		        </li>
		        <li><hr class="dropdown-divider"></li>
		        <li>
			        <span class="dropdown-item model-editor-context-menu-action btn-menu-item btn-edit-class btn-class-<%= row.IDClasse %>-edit"
				        data-idclasse="<%= row.IDClasse %>">
				        <i class="bi bi-pencil"></i>
				        <% if (user.LanguageContext == "IT") { %>
						        Modifica
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Edit
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                Editar
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                編輯
                            <% } %>
			        </span>
		        </li>
		        <li>
			        <span class="dropdown-item model-editor-context-menu-action btn-menu-item btn-class-<%= row.IDClasse %>-del"
				        data-idclasse="<%= row.IDClasse %>">
				        <i class="bi bi-trash"></i>
				        <% if (user.LanguageContext == "IT") { %>
                                Elimina
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Delete
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                Borrar
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                刪除
                            <% } %>
			        </span>
		        </li>
	        </ul>

            <%= row.Description %>

		</div>
        <div class="model-class-<%= row.IDClasse %>-attributes"></div>
	</div>

</form>