<div class="pager d-flex flex-wrap align-items-center gap-2 m-0 p-2">
        <div class="d-flex align-items-center gap-1">
            <% if (LanguageContext == "IT") { %>
                Pagina
            <% } %>
            <% if (LanguageContext == "GB") { %>
                Page
            <% } %>
            <% if (LanguageContext == "ES") { %>
                P&aacute;gina
            <% } %>
            <% if (LanguageContext == "CN") { %>
                頁
            <% } %>
            <input type="text" class="form-control form-control-sm pageIndex mini" style="width:3rem;" disabled="disabled" />
            <% if (LanguageContext == "IT") { %>
                di
            <% } %>
            <% if (LanguageContext == "GB") { %>
                of
            <% } %>
            <% if (LanguageContext == "ES") { %>
                de
            <% } %>
            <% if (LanguageContext == "CN") { %>
                /
            <% } %>
            <strong><label class="totalPage roboto-font"></label></strong>
            <i class="spinner-border text-primary" role="status" style="display:block; width:1rem; height:1rem;"></i>
        </div>
        <div>
            <a class="btn btn-prev btn-outline-secondary btn-sm pulsante" title="Pagina precedente">
            <% if (LanguageContext == "IT") { %>
                Precedente
            <% } %>
            <% if (LanguageContext == "GB") { %>
                Previous
            <% } %>
            <% if (LanguageContext == "ES") { %>
                Anterior
            <% } %>
            <% if (LanguageContext == "CN") { %>
                以前的
            <% } %>
            </a>
        </div>
        <div>
            <a class="btn btn-next btn-outline-secondary btn-sm pulsante" title="Pagina successiva">
            <% if (LanguageContext == "IT") { %>
                Successiva
            <% } %>
            <% if (LanguageContext == "GB") { %>
                Next
            <% } %>
            <% if (LanguageContext == "ES") { %>
                Pr&oacute;ximo
            <% } %>
            <% if (LanguageContext == "CN") { %>
                下一個
            <% } %>
            </a>
        </div>
        <div class="container-totalRecord ms-auto">
            <% if (LanguageContext == "IT") { %>
                Record Totali
            <% } %>
            <% if (LanguageContext == "GB") { %>
                Total Records
            <% } %>
            <% if (LanguageContext == "ES") { %>
                Registros totales
            <% } %>
            <% if (LanguageContext == "CN") { %>
                總記錄數
            <% } %>
            <span class="totalRecord" style="font-weight:bold;"></span>
        </div>
    </div>
</div>