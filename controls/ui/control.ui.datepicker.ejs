<div class="col-xs-12 p-0 mb-0 px-3">
    <label for="control_<%= row.ColumnName %>_TO" class="col-form-label">
		<% if (user.LanguageContext == "IT") { %>
            <%= row.Description_IT %>
        <% } %>
        <% if (user.LanguageContext == "GB") { %>
            <%= row.Description_GB %>
        <% } %>
        <% if (user.LanguageContext == "ES") { %>
            <%= row.Description_ES %>
		<% } %>
        <% if (user.LanguageContext == "CN") { %>
            <%= row.Description_CN %>
        <% } %>
    </label>
</div>
<div class="col-xs-6 p-0 mb-2 px-3">
    <input type="text" 
    data-idattributo="<%= row.ColumnName %>_FROM"
    data-idtipodati="<%= row.DataType %>"
    class="form-control" id="control_<%= row.ColumnName %>_FROM" 
    maxlength="<%= row.maxlength %>">
</div>
<div class="col-xs-6 p-0 mb-2 px-3">
    <input type="text" 
    data-idattributo="<%= row.ColumnName %>_TO"
    data-idtipodati="<%= row.DataType %>"
    class="form-control" id="control_<%= row.ColumnName %>_TO" 
    maxlength="<%= row.maxlength %>">
</div>