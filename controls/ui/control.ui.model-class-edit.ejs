<div id="confirm-delete-class"></div>
<div class="modal" id="container-class-edit" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg h-75 modal-dialog-centered" role="document">
        <div class="modal-content h-75">
            <div class="modal-header">
                <i class="bi bi-gear me-2"></i>
                <h5 class="modal-title f-roboto b">
                    <% if (user.LanguageContext == "IT") { %>
                    Modifica sezione
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                    Edit section
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                    Editar el campo
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                    編輯該字段
                    <% } %>/ <span class="class-header"></span>
                </h5>
                <button type="button" class="btn-close btn-cancel-class-edit" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body h-100">

                <input type="hidden" id="IDClasse" name="IDClasse" />
                <input type="hidden" id="IDVersione" name="IDVersione" />
                <div class="container-class-edit">
                </div>
                <div class="col-1 p-0">
                    <h5 class="f-roboto-b text-primary">
                        <% if (user.LanguageContext == "IT") { %>
                        Visibile
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Visible
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        visible
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        可見的
                        <% } %>
                    </h5>
                    <div class="col-12 p-0 form-switch">
                        <input id="class-Visibile" name="class-Visibile" class="form-check-input" type="checkbox">
                    </div>
                </div>
                <div class="col-12 p-0 mb-2">
                    <div class="col-12 p-0">
                        <div class="container-control-class-culture-textbox-descrizione" />
                    </div>
                </div>
                <div class="col-12 p-0 mb-3 form-switch">
                    <input id="class-InserimentoMultiplo" name="class-InserimentoMultiplo" class="form-check-input" type="checkbox">
                    <label class="form-check-label ms-2" for="class-InserimentoMultiplo">
                        <% if (user.LanguageContext == "IT") { %>
                        Inserimento multiplo
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Multiple entry
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        Inserción múltiple
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        多次輸入
                        <% } %>
                    </label>
                </div>
                <fieldset id="class-multiple-entry-settings" class="border rounded p-3 mb-3" style="display: none;">
                    <legend class="float-none w-auto px-2 fs-6 fw-bold">
                        <% if (user.LanguageContext == "IT") { %>
                        Inserimento multiplo
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Multiple entry
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        Inserción múltiple
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        多次輸入
                        <% } %>
                    </legend>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="class-NumeroCicliMin" class="form-label d-flex align-items-center gap-2">
                                <% if (user.LanguageContext == "IT") { %>
                                Ripetizione minima
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                Minimum repetitions
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                Repetición mínima
                                <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                最少重複次數
                                <% } %>
                                <span class="multiple-entry-minimum-indicator text-danger" aria-hidden="true"><i class="bi bi-x-circle-fill"></i></span>
                            </label>
                            <input id="class-NumeroCicliMin" name="class-NumeroCicliMin" type="number" min="2" step="1" required class="form-control">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="class-NumeroCicli" class="form-label">
                                <% if (user.LanguageContext == "IT") { %>
                                Ripetizione massima
                                <% } %>
                                <% if (user.LanguageContext == "GB") { %>
                                Maximum repetitions
                                <% } %>
                                <% if (user.LanguageContext == "ES") { %>
                                Repetición máxima
                                <% } %>
                                <% if (user.LanguageContext == "CN") { %>
                                最大重複次數
                                <% } %>
                            </label>
                            <input id="class-NumeroCicli" name="class-NumeroCicli" type="number" min="0" step="1" class="form-control">
                        </div>
                    </div>
                    <div class="alert alert-warning multiple-entry-validation-warning d-none mb-0" role="alert" aria-live="polite"></div>
                </fieldset>
                <div class="divider col-12 mt-4 mb-4"></div>
                <div class="col-12 p-0">
                    <a class="btn btn-success btn-md float-end btn-salva-classe">
                        <% if (user.LanguageContext == "IT") { %>
                        Salva
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Save
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        Ahorrar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        節省
                        <% } %>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>