<div id="confirm-delete-class"></div>
<div class="modal" id="container-class-edit" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg h-75 modal-dialog-centered" role="document">
        <div class="modal-content h-75">
            <div class="modal-header">
                <i class="bi bi-gear me-2"></i>
                <h5 class="modal-title f-roboto b">
                    <% if (user.LanguageContext == "IT") { %>
                    Modifica sezione
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                    Edit section
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                    Editar el campo
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                    編輯該字段
                    <% } %>/ <span class="class-header"></span>
                </h5>
                <button type="button" class="btn-close btn-cancel-class-edit" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body h-100">

                <input type="hidden" id="IDVersione" name="IDVersione" />
                <div class="container-class-edit">
                </div>
                <div class="col-xs-1 p-0">
                    <h5 class="f-roboto-b text-primary">
                        <% if (user.LanguageContext == "IT") { %>
                        Visibile
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Visible
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        visible
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        可見的
                        <% } %>
                    </h5>
                    <div class="col-xs-12 p-0 form-switch">
                        <input id="class-Visibile" name="class-Visibile" class="form-check-input" type="checkbox">
                    </div>
                </div>
                <div class="col-xs-12 p-0 mb-2">
                    <div class="col-xs-12 p-0">
                        <div class="container-control-class-culture-textbox-descrizione" />
                    </div>
                </div>
                <div class="divider col-xs-12 mt-4 mb-4"></div>
                <div class="col-xs-12 p-0">
                    <a class="btn btn-success btn-md float-end btn-salva-classe">
                        <% if (user.LanguageContext == "IT") { %>
                        Salva
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                        Save
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                        Ahorrar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                        節省
                        <% } %>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>