<div class="col-xs-12 p-2 m-0 event-workflow-history" style="border-bottom: 1px solid #ffffff;">
	<div class="divider-workflow-history col-lg-1 col-md-1 hidden-xs hidden-sm">
		<i class="bi bi-circle-fill bullet-workflow-history" style="color:<%= flowhistory.ColoreStato %>">
		</i>
	</div>
	<div class="data-workflow-history col-lg-3 col-md-3 col-sm-2 col-xs-12">
		<div class="col-xs-12 p-0">
			<span class="f-roboto-b"><%= flowhistory.DataRegistrazione %></span><span class="f-roboto">, <%= flowhistory.OraRegistrazione %></span>
		</div>
		<div class="col-xs-12 p-0 hidden-sm hidden-xs">
			<span class="f-roboto text-secondary">
				<%= flowhistory.Istanziatore %>
			</span>
		</div>
	</div>
	<div class="stato-workflow-history col-lg-6 col-md-6 col-sm-6 col-xs-8">
		<i class="bi bi-circle-fill hidden-lg hidden-md" style="color:<%= flowhistory.ColoreStato %>"></i>
		<span class="hidden-lg hidden-md">&nbsp;</span>
		<span class="f-roboto"><%= flowhistory.Stato %></span>
		<span class="f-roboto text-secondary hidden-lg hidden-md">
			&nbsp;(<%= flowhistory.Istanziatore %>)
		</span>
		<% if (flowhistory.Note != "" && flowhistory.Note != undefined) { %>
			<div class="f-roboto p-3 px-1">
				<i class="bi bi-arrow-return-right">&nbsp;<%= flowhistory.Note %></i>
			</div>
		<% } %>
	</div>
	<div class="durata-workflow-history col-lg-2 col-md-2 col-sm-3 col-xs-4 mt-0 text-right">
		<span class="f-roboto text-secondary">
			<% if (flowhistory.GiorniStato == null) { %>
				<span class="badge bg-danger">
					<% if (LanguageContext == "IT") { %>
                        Inizio
                    <% } %>
                    <% if (LanguageContext == "GB") { %>
                        Start
                    <% } %>
                    <% if (LanguageContext == "ES") { %>
                        Comenzar
					<% } %>
                    <% if (LanguageContext == "CN") { %>
                        開始
                    <% } %>
				</span>
			<% } else { %>
				<% if (eval(flowhistory.GiorniStato) > 0) { %>
					<%= flowhistory.GiorniStato %> 

					<% if (eval(flowhistory.GiorniStato) == 1) { %>
						<% if (LanguageContext == "IT") { %>
							giorno
						<% } %>
						<% if (LanguageContext == "GB") { %>
							day
						<% } %>
						<% if (LanguageContext == "ES") { %>
							d&iacute;a
						<% } %>
						<% if (LanguageContext == "CN") { %>
							天
						<% } %>
					<% } else { %>
						<% if (LanguageContext == "IT") { %>
							giorni
						<% } %>
						<% if (LanguageContext == "GB") { %>
							days
						<% } %>
						<% if (LanguageContext == "ES") { %>
							d&iacute;as
						<% } %>
						<% if (LanguageContext == "CN") { %>
							天
						<% } %>
					<% } %>

				<% } else if (eval(flowhistory.OreStato) > 0) { %>
					<%= flowhistory.OreStato %> 

					<% if (eval(flowhistory.OreStato) == 1) { %>
						<% if (LanguageContext == "IT") { %>
							ora
						<% } %>
						<% if (LanguageContext == "GB") { %>
							hour
						<% } %>
						<% if (LanguageContext == "ES") { %>
							hora
						<% } %>
						<% if (LanguageContext == "CN") { %>
							小時
						<% } %>
					<% } else { %>
						<% if (LanguageContext == "IT") { %>
							ore
						<% } %>
						<% if (LanguageContext == "GB") { %>
							hours
						<% } %>
						<% if (LanguageContext == "ES") { %>
							horas
						<% } %>
						<% if (LanguageContext == "CN") { %>
							小時
						<% } %>
					<% } %>

				<% } else { %>

					<%= flowhistory.MinutiStato %> 

					<% if (eval(flowhistory.MinutiStato) == 1) { %>
						<% if (LanguageContext == "IT") { %>
							minuto
						<% } %>
						<% if (LanguageContext == "GB") { %>
							minute
						<% } %>
						<% if (LanguageContext == "ES") { %>
							minuto
						<% } %>
						<% if (LanguageContext == "CN") { %>
							分鐘
						<% } %>
					<% } else { %>
						<% if (LanguageContext == "IT") { %>
							minuti
						<% } %>
						<% if (LanguageContext == "GB") { %>
							minutes
						<% } %>
						<% if (LanguageContext == "ES") { %>
							minutos
						<% } %>
						<% if (LanguageContext == "CN") { %>
							分鐘
						<% } %>
					<% } %>


				<% } %>
				&nbsp;<i class="bi bi-clock"></i>
				<% if (flowhistory.StatoFinale == "FINE" || flowhistory.StatoFinale == "END") { %>
					<div class="col-xs-12 p-0 pt-3">
						<span class="badge bg-success">
							<% if (LanguageContext == "IT") { %>
								Fine
							<% } %>
							<% if (LanguageContext == "GB") { %>
								End
							<% } %>
							<% if (LanguageContext == "ES") { %>
								Fin
							<% } %>
							<% if (LanguageContext == "CN") { %>
								結尾
							<% } %>
						</span>
					</div>
				<% } %>
			<% } %>
		</span>
	</div>
	<hr class="hidden-lg hidden-md col-xs-12 p-0" style="border-top:1px solid #c1c1c1;" />
</div>