<style>
#container-attribute-edit .modal-body { font-size: .85rem; }
#container-attribute-edit .attribute-edit-divider { width: 1px; padding: 0; margin: 0 .5rem; background: #dee2e6; }
#container-attribute-edit h5 { font-size: .9rem; margin: .5rem 0 .25rem; }
#container-attribute-edit .form-control, #container-attribute-edit .form-select { font-size: .85rem; padding: .25rem .5rem; }
#container-attribute-edit .attribute-toggle { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #eee; padding: .25rem 0 !important; }
#container-attribute-edit .attribute-toggle h5 { margin: 0; }
#container-attribute-edit .attribute-toggle .form-switch { width: auto; margin: 0; }
#container-attribute-edit .numero-file, #container-attribute-edit .dimensione-file { padding-left: 0 !important; }
#container-attribute-value-visibility .gruppo-operativo a,
#container-attribute-value-visibility .profilo-utente a { text-decoration: none; }
#container-attribute-value-visibility .gruppo-operativo a.active,
#container-attribute-value-visibility .profilo-utente a.active { font-weight: 700; }
#container-attribute-value-visibility .workflow-profile-row a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#container-attribute-value-visibility .card-body > .form-check.form-switch .form-check-input,
#container-attribute-value-visibility #attribute-value-visibility-profiles .form-check-input {
    flex-shrink: 0;
    margin: 0;
}
#container-attribute-value-visibility #attribute-value-visibility-profiles .workflow-profile-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0;
}
</style>
<div id="confirm-delete-attribute"></div>
<div class="modal" id="container-attribute-edit" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <i class="bi bi-gear me-2"></i>
                <h5 class="modal-title f-roboto b">
                    <% if (user.LanguageContext == "IT") { %>
                        Modifica campo
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                        Edit field
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                        Editar el campo
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                        編輯該字段
                    <% } %>/ <span class="attribute-header"></span>
                </h5>
                <button type="button" class="btn-close btn-cancel-attribute-edit" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body was-validated">

                <input type="hidden" id="IDClasse" name="IDClasse" />
                <input type="hidden" id="IDAttributo" name="IDAttributo" />
                <div class="container-form-edit">
                </div>

                <div class="row g-3 attribute-edit-columns">
                <div class="col attribute-edit-main">
                    <div class="col-12 p-0">
                        <div class="container-control-culture-textbox-descrizione"></div>
                    </div>
                    <div class="col-12 p-0 mb-2">
                    <h5 class="f-roboto-b text-primary">
                        <% if (user.LanguageContext == "IT") { %>
                            Tipo
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Type
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Tipo
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            類型
                        <% } %>
                    </h5>
                    <select id="IDTipoDati" required="" class="form-select tipo-dati">
                    </select>
                    <div class="col-12 p-0 lunghezza-massima" style="display: none;">
                        <h5 class="f-roboto-b text-primary">
                            <% if (user.LanguageContext == "IT") { %>
                                Lunghezza massima
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Maximum length
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                Longitud m&aacute;xima
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                最大長度
                            <% } %>
                        </h5>
                        <div class="col-12 p-0 form-switch">
                            <input id="Lunghezza" name="Lunghezza" class="form-control number" type="textbox" maxlength="4" required>
                        </div>
                    </div>

                    <div class="col-12 p-0 valore-minimo" style="display: none;">
                        <h5 class="f-roboto-b text-primary">
                            <% if (user.LanguageContext == "IT") { %>
                                Valore minimo
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Minimum value
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                Valor m&iacute;nimo
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                最小值
                            <% } %>
                        </h5>
                        <div class="col-12 p-0 form-switch">
                            <input id="ValoreMinimo" name="ValoreMinimo" class="form-control number" type="textbox" maxlength="5">
                        </div>
                    </div>

                    <div class="col-12 p-0 numero-righe" style="display: none;">
                        <h5 class="f-roboto-b text-primary">
                            <% if (user.LanguageContext == "IT") { %>
                                Numero righe
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Number of rows
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                N&aacute;mero de filas
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                行數
                            <% } %>
                        </h5>
                        <div class="col-12 p-0 form-switch">
                            <input id="NumeroRighe" name="NumeroRighe" class="form-control number" type="textbox" maxlength="1" required>
                        </div>
                    </div>

                    <div class="col-12 p-0 numero-file" style="display: none;">
                        <h5 class="f-roboto-b text-primary">
                            <% if (user.LanguageContext == "IT") { %>
                                Numero file accettati
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Number of accepted files
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                N&uacute;mero de archivos aceptados
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                已接受的文件數量
                            <% } %>
                        </h5>
                        <div class="col-12 p-0 form-switch">
                            <input id="FileNumber" name="FileNumber" class="form-control number" type="textbox" maxlength="2" required>
                        </div>
                    </div>

                    <div class="col-12 p-0 dimensione-file" style="display: none;">
                        <h5 class="f-roboto-b text-primary">
                            <% if (user.LanguageContext == "IT") { %>
                                Dimensione consentita
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                Permitted size
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                Peso de archivo permitido
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                允許尺寸
                            <% } %> (MB)
                        </h5>
                        <div class="col-12 p-0 form-switch">
                            <input id="FileWeight" name="FileWeight" class="form-control number" type="textbox" maxlength="2" required>
                        </div>
                    </div>

                    <div class="col-12 p-1 mt-2 form-switch tipo-file" style="display: none;">
                        <input type="hidden" id="FileTypes" name="FileTypes" />
                        <h5 class="f-roboto-b text-primary">
                            <% if (user.LanguageContext == "IT") { %>
                                Tipo file
                            <% } %>
                            <% if (user.LanguageContext == "GB") { %>
                                File type
                            <% } %>
                            <% if (user.LanguageContext == "ES") { %>
                                Tipo de archivo
                            <% } %>
                            <% if (user.LanguageContext == "CN") { %>
                                文件類型
                            <% } %>
                        </h5>
                        <div class="col-12 p-0 mb-2">
                            <div class="col-12 p-0 form-switch">
                                <input id="file-type-text" name="file-type-text" class="form-check-input file-type" data-type="text" type="checkbox">
                                <spam class="p-1">
                                    &nbsp;
                                    <% if (user.LanguageContext == "IT") { %>
                                        Documento di testo
                                    <% } %>
                                    <% if (user.LanguageContext == "GB") { %>
                                        Text document
                                    <% } %>
                                    <% if (user.LanguageContext == "ES") { %>
                                        Documento de texto
                                    <% } %>
                                    <% if (user.LanguageContext == "CN") { %>
                                        文字文檔
                                    <% } %>
                                </span>
                            </div>
                        </div>
                        <div class="col-12 p-0 mb-2">
                            <div class="col-12 p-0 form-switch">
                                <input id="file-type-pdf" name="file-type-pdf" class="form-check-input file-type" data-type="pdf" type="checkbox">
                                <spam class="p-1">
                                    &nbsp;
                                    <% if (user.LanguageContext == "IT") { %>
                                        Documento PDF
                                    <% } %>
                                    <% if (user.LanguageContext == "GB") { %>
                                        PDF document
                                    <% } %>
                                    <% if (user.LanguageContext == "ES") { %>
                                        Documento PDF
                                    <% } %>
                                    <% if (user.LanguageContext == "CN") { %>
                                        PDF 文件
                                    <% } %>
                                </span>
                            </div>
                        </div>
                        <div class="col-12 p-0 mb-2">
                            <div class="col-12 p-0 form-switch">
                                <input id="file-type-image" name="file-type-image" class="form-check-input file-type" data-type="image" type="checkbox">
                                <spam class="p-1">
                                    &nbsp;
                                    <% if (user.LanguageContext == "IT") { %>
                                        Immagine
                                    <% } %>
                                    <% if (user.LanguageContext == "GB") { %>
                                        Image
                                    <% } %>
                                    <% if (user.LanguageContext == "ES") { %>
                                        Imagen
                                    <% } %>
                                    <% if (user.LanguageContext == "CN") { %>
                                        影像
                                    <% } %>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="invalid-feedback tipo-file-error" style="display: none;">
                        <% if (user.LanguageContext == "IT") { %>Seleziona almeno un tipo file<% } %>
                        <% if (user.LanguageContext == "GB") { %>Select at least one file type<% } %>
                        <% if (user.LanguageContext == "ES") { %>Seleccione al menos un tipo de archivo<% } %>
                        <% if (user.LanguageContext == "CN") { %>請至少選擇一種文件類型<% } %>
                    </div>
                    
		            <a class="btn btn-secondary btn-sm btn-configura-lista mt-2" style="display: none;">
			            <% if (user.LanguageContext == "IT") { %>
                            Configura lista
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Configure list
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Configurar la lista
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            配置清單
                        <% } %>
		            </a>
                </div>
                </div>
                <div class="col-auto attribute-edit-divider"></div>
                <div class="col attribute-edit-toggles">
                <div class="attribute-toggle p-0">
                    <h5 class="f-roboto-b text-primary">
                        <% if (user.LanguageContext == "IT") { %>
                            Visibile
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Visible
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            visible
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            可見的
                        <% } %>
                    </h5>
                    <div class="col-12 p-0 form-switch">
                        <input id="Visibile" name="Visibile" class="form-check-input btn-toggle-" type="checkbox">
                    </div>
                </div>
                <div class="attribute-toggle p-0">
                    <h5 class="f-roboto-b text-primary">
                        <% if (user.LanguageContext == "IT") { %>
                            Obbligatorio
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Required
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Obligatorio
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            強制性的
                        <% } %>
                    </h5>
                    <div class="col-12 p-0 form-switch">
                        <input id="Obbligatorio" name="Obbligatorio" class="form-check-input btn-toggle-" type="checkbox">
                    </div>
                </div>
                <div class="attribute-toggle p-0">
                    <h5 class="f-roboto-b text-primary">
                        <% if (user.LanguageContext == "IT") { %>Filtro<% } %>
                        <% if (user.LanguageContext == "GB") { %>Filter<% } %>
                        <% if (user.LanguageContext == "ES") { %>Filtro<% } %>
                        <% if (user.LanguageContext == "CN") { %>筛选<% } %>
                    </h5>
                    <div class="col-12 p-0 form-switch">
                        <input id="IsFilter" name="IsFilter" class="form-check-input btn-toggle-" type="checkbox">
                    </div>
                </div>
                <div class="attribute-toggle p-0">
                    <h5 class="f-roboto-b text-primary">
                        <% if (user.LanguageContext == "IT") { %>Riepilogo<% } %>
                        <% if (user.LanguageContext == "GB") { %>Summary<% } %>
                        <% if (user.LanguageContext == "ES") { %>Resumen<% } %>
                        <% if (user.LanguageContext == "CN") { %>汇总<% } %>
                    </h5>
                    <div class="col-12 p-0 form-switch">
                        <input id="IsSummary" name="IsSummary" class="form-check-input btn-toggle-" type="checkbox">
                    </div>
                </div>
                </div>
                </div>
                <div class="divider col-12 mt-4 mb-4"></div>
                <div class="col-12 p-0">
		            <a class="btn btn-success btn-md float-end btn-salva-attributo">
			            <% if (user.LanguageContext == "IT") { %>
                            Salva
                        <% } %>
                        <% if (user.LanguageContext == "GB") { %>
                            Save
                        <% } %>
                        <% if (user.LanguageContext == "ES") { %>
                            Ahorrar
                        <% } %>
                        <% if (user.LanguageContext == "CN") { %>
                            節省
                        <% } %>
		            </a>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal" id="container-attribute-value-visibility" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered h-75" role="document">
        <div class="modal-content h-75">
            <div class="modal-header">
                <h5 class="modal-title text-primary">
                    <i class="bi bi-gear"></i>&nbsp;
                    <% if (LanguageContext == "IT") { %>Imposta visibilità<% } %>
                    <% if (LanguageContext == "GB") { %>Set visibility<% } %>
                    <% if (LanguageContext == "ES") { %>Establecer visibilidad<% } %>
                    <% if (LanguageContext == "CN") { %>設定可見性<% } %>
                    <span class="attribute-value-visibility-description"></span>
                </h5>
                <button type="button" class="btn-close btn-close-attribute-value-visibility" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-1 pt-1" style="overflow-y:hidden;">
                <input type="hidden" id="attribute-value-visibility-id" />
                <div class="row g-1 h-100">
                    <div class="col-6 p-0 h-100">
                        <div class="card h-100 p-0">
                            <div class="card-header p-3 f-roboto"><b>
                                <% if (LanguageContext == "IT") { %>Gruppi di lavoro<% } %>
                                <% if (LanguageContext == "GB") { %>Working groups<% } %>
                                <% if (LanguageContext == "ES") { %>Grupos de trabajo<% } %>
                                <% if (LanguageContext == "CN") { %>工作小組<% } %>
                            </b></div>
                            <div class="card-body h-100 p-2 f-roboto">
                                <div id="attribute-value-visibility-groups" style="overflow-y:auto; height:90%;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 p-0 h-100">
                        <div class="card h-100 p-0">
                            <div class="card-header p-3 f-roboto"><b>
                                <% if (LanguageContext == "IT") { %>Profili utente<% } %>
                                <% if (LanguageContext == "GB") { %>User profiles<% } %>
                                <% if (LanguageContext == "ES") { %>Perfiles de usuario<% } %>
                                <% if (LanguageContext == "CN") { %>使用者資料<% } %>
                            </b><span class="attribute-value-visibility-group"></span></div>
                            <div class="card-body h-100 p-2 f-roboto">
                                <div id="attribute-value-visibility-profiles" style="overflow-y:auto; height:90%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-close-attribute-value-visibility" data-bs-dismiss="modal">
                    <% if (LanguageContext == "IT") { %>Chiudi<% } %>
                    <% if (LanguageContext == "GB") { %>Close<% } %>
                    <% if (LanguageContext == "ES") { %>Cerrar<% } %>
                    <% if (LanguageContext == "CN") { %>關閉<% } %>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="container-attribute-edit-values" tabindex="-1" role="dialog" data-args="" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg h-75 modal-dialog-centered" role="document">
        <div class="modal-content h-75">
            <div class="modal-header">
                <i class="bi bi-gear me-2"></i>
                <h5 class="modal-title f-roboto b">
			        <% if (user.LanguageContext == "IT") { %>
                        Configura lista
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                        Configure list
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                        Configurar la lista
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                        配置清單
                    <% } %>/ <span class="attribute-header"></span>
                </h5>
                <button type="button" class="btn-close btn-cancel-attribute-edit-values" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container-attribute-edit-values-list"></div>
                <div class="col-12 p-1 mt-1 container-value-edit-culture"></div>
                <input type="hidden" id="IDValue" />
                <div class="divider col-12 mt-4 mb-4"></div>
		        <a class="btn btn-success btn-md float-end btn-salva-lista" style="display: none;">
			        <% if (user.LanguageContext == "IT") { %>
                        Salva
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                        Save
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                        Ahorrar
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                        節省
                    <% } %>
		        </a>
		        <a class="btn btn-danger btn-md float-end btn-delete-lista me-2" disabled style="display: none;">
			        <% if (user.LanguageContext == "IT") { %>
                        Elimina
                    <% } %>
                    <% if (user.LanguageContext == "GB") { %>
                        Delete
                    <% } %>
                    <% if (user.LanguageContext == "ES") { %>
                        Ahorrar
                    <% } %>
                    <% if (user.LanguageContext == "CN") { %>
                        節省
                    <% } %>
		        </a>
            </div>
        </div>
    </div>
</div>